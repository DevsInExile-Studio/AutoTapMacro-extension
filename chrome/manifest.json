{
  "manifest_version": 3,
  "name": "AutoTap Macro | Recorder & Scripts",
  "version": "1.4.2",
  "description": "Record clicks, typing and scrolling. Replay browser macros and run your own JavaScript in a warm, paper-inspired workspace.",
  "minimum_chrome_version": "138",
  "permissions": ["activeTab", "scripting", "storage", "userScripts", "offscreen"],
  "optional_permissions": ["notifications", "downloads", "clipboardWrite"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "AutoTap Macro",
    "default_popup": "popup.html",
    "default_icon": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" }
  },
  "icons": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "options_page": "workspace.html",
  "commands": {
    "stop": { "suggested_key": { "default": "Alt+Shift+X" }, "description": "Stop recording or macro playback" },
    "record": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Record a new macro in this tab" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
